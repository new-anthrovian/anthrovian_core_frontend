# Copy to .env.local and fill in real values. In production, set
# NEXT_PUBLIC_VIDEO_BASE in your host's env-var UI (e.g. Vercel). The R2_*
# vars below are for upload/management scripts only — they are NOT read
# by the Next.js app at runtime.

# ============================================================
#  RUNTIME — read by the Next.js app
# ============================================================
# CDN root for video + poster assets. Strip trailing slash.
# Unset/blank => app falls back to /videos/ (public/videos/).
NEXT_PUBLIC_VIDEO_BASE=

# ============================================================
#  CLOUDFLARE R2 — for upload / management scripts ONLY
# ============================================================
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_URL=
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
